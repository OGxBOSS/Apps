<script>
const K='doortracker.v1',$=s=>document.querySelector(s),uid=()=>Math.random().toString(36).slice(2,9);
const DEF=[['deal','Deal','Deal','deal'],['rej','+','Rejection','rej'],['cb','CB','Come Back','cb'],['v','V','Vacant','vac'],['rent','Rent','Rent','other'],['else','Else','Else','other']].map(a=>({id:a[0],sym:a[1],label:a[2],type:a[3]}));
const TYPES={deal:'Deal',rej:'Rejection',cb:'Comeback',nh:'Not home',vac:'Vacant',other:'Other'};
function h(t,p,...c){const e=document.createElement(t);for(const k in p||{}){if(k==='class')e.className=p[k];else if(k.startsWith('on')){p[k]&&e.addEventListener(k.slice(2),p[k])}else if(k==='value')e.value=p[k];else e.setAttribute(k,p[k])}c.flat().forEach(x=>x!=null&&e.append(x));return e}
let fresh0=false,S;try{S=JSON.parse(localStorage.getItem(K))}catch(e){}
const okS=x=>x&&x.sessions&&x.sessions.length;
if(!okS(S)){try{const b=JSON.parse(localStorage.getItem(K+'.bak'));if(okS(b))S=b}catch(e){}}
else if(S.sessions.some(x=>x.rows&&x.rows.length)){try{localStorage.setItem(K+'.bak',JSON.stringify(S))}catch(e){}}
function ns(){return{id:uid(),date:Date.now(),street:'',step:-2,seg:0,fresh:false,cross:false,rows:[]}}
if(!S||!S.sessions||!S.sessions.length){fresh0=true;const s=ns();S={resp:DEF.map(x=>({...x})),showRed:false,auto:true,jump:false,sessions:[s],cur:s.id}}
const cs=()=>S.sessions.find(x=>x.id===S.cur)||S.sessions[0];
let CL=null,wt,qt;const dirty=new Set();
async function flush(){if(!CL)return;const ids=[...dirty];dirty.clear();try{
 await CL.doc('settings').set({json:JSON.stringify({resp:S.resp,showRed:S.showRed,auto:S.auto,jump:S.jump,cur:S.cur,pay:S.pay,payMode:S.payMode,goal:S.goal,order:S.sessions.map(x=>x.id),t:S.t})});
 for(const id of ids){const x=S.sessions.find(y=>y.id===id);if(x)await CL.doc('sheet_'+id).set({json:JSON.stringify(x)})}
}catch(e){ids.forEach(i=>dirty.add(i))}}
const save=()=>{S.t=Date.now();try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}dirty.add(S.cur);clearTimeout(wt);wt=setTimeout(flush,600)};
function migA(){const ap=S.resp.filter(x=>x.type==='appt');if(!ap.length)return;const cb=S.resp.find(x=>x.type==='cb');
 S.sessions.forEach(s=>s.rows.forEach(r=>{if(r.t==='door'&&ap.some(x=>x.id===r.r)){r.apt=1;if(cb)r.r=cb.id}}));
 if(cb)S.resp=S.resp.filter(x=>x.type!=='appt');else ap.forEach(x=>x.type='cb');save()}
const R=id=>S.resp.find(r=>r.id===id);
const doors=s=>s.rows.filter(r=>r.t==='door');
function migB(){const nh=S.resp.filter(x=>x.type==='nh');if(!nh.length)return;
 S.sessions.forEach(s=>s.rows.forEach(r=>{if(r.t==='door'&&nh.some(x=>x.id===r.r)){r.r=null;r.d=''}}));
 const i=S.resp.indexOf(nh[0]);S.resp=S.resp.filter(x=>x.type!=='nh');
 if(!S.resp.some(x=>x.id==='rent'))S.resp.splice(Math.min(i,S.resp.length),0,{id:'rent',sym:'Rent',label:'Rent',type:'other'});save()}
function dk(t){const d=new Date(t);return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate()}
function DEFG(){return{mode:'week',metric:'doors',doors:{day:80,week:400},deals:{day:2,week:10}}}
function migC(){let ch=false;if(!S.pay||typeof S.pay!=='object'){S.pay={};ch=true}if(!S.goal){S.goal=DEFG();ch=true}
 S.sessions.forEach(x=>{if(x.pay!==undefined){const k=dk(x.date);if(x.pay&&!S.pay[k])S.pay[k]=x.pay;delete x.pay;ch=true}});if(ch)save()}
function migrate(){migA();migB();migC()}
migrate();
const typ=r=>{const x=R(r.r),t=x?x.type:'none';return r.apt&&t==='cb'?'appt':t};
const pct=(a,b)=>b?Math.round(a/b*100)+'%':'–';
const tm=t=>{if(!t)return'–';const d=new Date(t),T=d.toLocaleTimeString([],{hour:'numeric',minute:'2-digit'});return d.toDateString()===new Date().toDateString()?T:d.toLocaleDateString([],{month:'short',day:'numeric'})+' '+T};
const dt=t=>new Date(t).toLocaleDateString([],{weekday:'short',month:'short',day:'numeric'});
const dur=ms=>{const m=Math.max(0,Math.floor(ms/6e4));return Math.floor(m/60)+'h '+String(m%60).padStart(2,'0')+'m'};
const hf=n=>(n%12||12)+(n<12?' AM':' PM');
function stats(s){
 const d=doors(s),c={deal:0,rej:0,nh:0,vac:0,cb:0,appt:0,other:0,none:0,act:0,down:0,hr:{}};
 d.forEach((r,i)=>{const t=typ(r);c[t]++;const H=new Date(r.ts).getHours(),b=c.hr[H]=c.hr[H]||{n:0,d:0};b.n++;if(t==='deal')b.d++;
  const nx=d[i+1];if(nx){const g=nx.ts-r.ts,big=t==='deal'||t==='rej';if(g<=20*6e4||(big&&g<=90*6e4))c.act+=g;else c.down+=g}});
 c.nh+=c.none;c.n=d.length;c.start=d.length?d[0].ts:0;c.last=d.length?d[d.length-1].ts:0;
 let k=0;for(let i=d.length-1;i>=0&&typ(d[i])!=='deal';i--)k++;c.since=k;
 let best=null;for(const H in c.hr){const b=c.hr[H];if(!best||b.d>best.d||(b.d===best.d&&b.n>best.n))best={H:+H,...b}}c.best=best;
 return c}

function render(){
 const s=cs(),c=stats(s),H=hist(),mn=$('#main'),sc=mn.scrollTop,tb=$('#tb');
 if(document.activeElement!==$('#st'))$('#st').value=s.street||'';
 $('#dts').textContent=dt(s.date)+(CL?' ☁':'');$('#k1').textContent=c.n;$('#k2').textContent=c.deal;$('#k3').textContent=pct(c.deal,c.n);$('#k4').textContent=dur(c.act);hud(H);
 $('#bRed').classList.toggle('on',S.showRed);
 const nc=c.cb+c.appt;$('#cbn').textContent=nc||'';
 tb.replaceChildren();
